{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NyaPassword",
  "version": "0.1.5",
  "identifier": "app.nya.password",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "npm run web",
    "frontendDist": "../../common/web/dist-desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NyaPassword",
        "width": 1200,
        "height": 780,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost npwsync: http://npwsync.localhost https: wss: ws:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "worker-src": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "publisher": "NyaPassword contributors",
    "shortDescription": "NyaPassword",
    "longDescription": "Self-hosted, end-to-end encrypted password manager",
    "category": "Utility",
    "copyright": "MIT License",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
